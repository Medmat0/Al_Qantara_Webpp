generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id                       Int                      @id @default(autoincrement())
  nom                      String                   @db.VarChar(100)
  prenom                   String                   @db.VarChar(100)
  email                    String                   @unique @db.VarChar(255)
  motDePasse               String                   @db.VarChar(255)
  photoProfil              String?                  @db.VarChar(255)
  role                     Role
  dateInscription          DateTime
  statut                   Statut
  emailVerificationToken   String?                  @db.VarChar(255)
  emailVerified            Boolean                  @default(false)
  passwordResetToken       String?                  @db.VarChar(255)
  passwordResetTokenExpire String?
  evenements               Evenement[]
  revues                   Revue[]
  articles                 Article[]
  adhesion                 Adhesion?
  accesEvenements          AccesEvenement[]
  likes                    LikeEvenement[]
  commentaires             CommentaireEvenement[]
  ratings                  RatingEvenement[]
  partages                 PartageEvenement[]
  participations           ParticipationEvenement[]
  offre                    Offre[]
  candidatures             Candidature[]
  paiements                PaiementEvenement[]
  messagesEnvoyes          Message[]                @relation("MessagesEnvoyes")
  messagesRecus            Message[]                @relation("MessagesRecus")
}

enum Role {
  ADMIN
  ADHERENT
  USER
}

enum Statut {
  ACTIF
  INACTIF
}

model Evenement {
  id              Int                      @id @default(autoincrement())
  titre           String                   @db.VarChar(255)
  description     String
  dateDebut       DateTime
  dateFin         DateTime
  lieu            String                   @db.VarChar(255)
  type            TypeEvenement
  createdBy       Int
  createur        Utilisateur              @relation(fields: [createdBy], references: [id])
  acces           AccesEvenement[]
  images          String[]                 @db.VarChar(255)
  video           String?                  @db.VarChar(255)
  latitude        Float?
  longitude       Float?
  placesTotal     Int?
  placesRestantes Int?
  likes           LikeEvenement[]
  comments        CommentaireEvenement[]
  ratings         RatingEvenement[]
  partages        PartageEvenement[]
  participations  ParticipationEvenement[]
  isPayant        Boolean                  @default(false)
  prix            Float?
  helloAssoId     String?                  @db.VarChar(255)
  paiements       PaiementEvenement[]
  messages        Message[]
}

enum TypeEvenement {
  INTERNE
  EXTERNE
}

model Newsletter {
  id              Int      @id @default(autoincrement())
  email           String   @unique @db.VarChar(255)
  dateInscription DateTime
}

model Adhesion {
  id            Int            @id @default(autoincrement())
  utilisateur   Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId Int            @unique
  dateDemande   DateTime
  statut        StatutAdhesion
}

enum StatutAdhesion {
  EN_ATTENTE
  ACCEPTE
  REJETE
}

model Contact {
  id        Int      @id @default(autoincrement())
  nom       String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  sujet     String   @db.VarChar(255)
  message   String
  dateEnvoi DateTime
}

// relier article -> revue

model Revue {
  id                    Int         @id @default(autoincrement())
  titre                 String      @db.VarChar(255)
  description           String?     @db.Text
  mois                  String?
  annee                 String?
  fichier               String      @db.VarChar(255)
  datePublication       DateTime
  nombreVues            Int         @default(0)
  nombreTelechargements Int         @default(0)
  createdBy             Int
  createur              Utilisateur @relation(fields: [createdBy], references: [id])
  articles              Article[]
}

model Article {
  id             Int                @id @default(autoincrement())
  titre          String             @db.VarChar(255)
  contenu        String             @db.Text
  auteur         String             @db.VarChar(100)
  dateSoumission DateTime
  createdBy      Int
  createur       Utilisateur        @relation(fields: [createdBy], references: [id])
  revueId        Int
  revue          Revue              @relation(fields: [revueId], references: [id], onDelete: Cascade)
  categories     CategorieArticle[]
}

model CategorieArticle {
  id          Int       @id @default(autoincrement())
  nom         String    @db.VarChar(100)
  description String?   @db.Text
  articles    Article[]
}

model AccesEvenement {
  id            Int         @id @default(autoincrement())
  evenementId   Int
  utilisateurId Int
  evenement     Evenement   @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
}

model LikeEvenement {
  id            Int         @id @default(autoincrement())
  evenementId   Int
  utilisateurId Int
  dateLike      DateTime    @default(now())
  evenement     Evenement   @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([evenementId, utilisateurId])
}

model CommentaireEvenement {
  id              Int         @id @default(autoincrement())
  evenementId     Int
  utilisateurId   Int
  contenu         String
  dateCommentaire DateTime    @default(now())
  evenement       Evenement   @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
}

model RatingEvenement {
  id               Int         @id @default(autoincrement())
  evenementId      Int
  utilisateurId    Int
  noteOrganisateur Int
  noteLieu         Int
  noteAmbiance     Int
  noteEvenement    Int
  commentaire      String?
  dateRating       DateTime    @default(now())
  evenement        Evenement   @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  utilisateur      Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([evenementId, utilisateurId])
}

model PartageEvenement {
  id                Int         @id @default(autoincrement())
  evenementId       Int
  utilisateurId     Int
  emailDestinataire String
  message           String?
  datePartage       DateTime    @default(now())
  evenement         Evenement   @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  utilisateur       Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
}

model ParticipationEvenement {
  id                Int                 @id @default(autoincrement())
  evenementId       Int
  utilisateurId     Int
  statut            StatutParticipation @default(EN_ATTENTE)
  qrCode            String?             @db.Text
  dateParticipation DateTime            @default(now())
  evenement         Evenement           @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  utilisateur       Utilisateur         @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([evenementId, utilisateurId])
}

enum StatutParticipation {
  EN_ATTENTE
  CONFIRME
  ANNULE
}

enum ContractType {
  CDI
  CDD
  BENEVOLAT
  FREELANCE
  STAGE
  INTERIM
  APPRENTISSAGE
}

model Offre {
  id              Int           @id @default(autoincrement())
  titre           String        @db.VarChar(255)
  description     String        @db.Text
  tags            String[]      @db.VarChar(100)
  lieuDeTravail   String        @db.VarChar(255)
  typeDeContrat   ContractType
  dateDebut       DateTime
  datePublication DateTime      @default(now())
  createdBy       Int
  createur        Utilisateur   @relation(fields: [createdBy], references: [id])
  candidatures    Candidature[]
}

model Candidature {
  id               Int               @id @default(autoincrement())
  offreId          Int
  utilisateurId    Int
  dateCandidature  DateTime          @default(now())
  statut           StatutCandidature @default(EN_ATTENTE)
  lettreMotivation String?           @db.Text
  cv               String?           @db.VarChar(255)
  skills           String[]          @db.VarChar(100)
  experiences      String[]          @db.VarChar(500)
  score            Int?              @default(0)
  offre            Offre             @relation(fields: [offreId], references: [id], onDelete: Cascade)
  utilisateur      Utilisateur       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([offreId, utilisateurId])
}

enum StatutCandidature {
  EN_ATTENTE
  ACCEPTEE
  REJETEE
}

model PaiementEvenement {
  id            Int            @id @default(autoincrement())
  evenementId   Int
  utilisateurId Int
  montant       Float
  statut        StatutPaiement
  datePaiement  DateTime       @default(now())
  reference     String         @db.VarChar(255)
  evenement     Evenement      @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([evenementId, utilisateurId])
}

enum StatutPaiement {
  EN_ATTENTE
  VALIDE
  ANNULE
  REMBOURSE
}

model Message {
  id             Int           @id @default(autoincrement())
  contenu        String        @db.Text
  type           TypeMessage
  dateEnvoi      DateTime      @default(now())
  dateExpiration DateTime
  estLu          Boolean       @default(false)
  expediteur     Utilisateur   @relation("MessagesEnvoyes", fields: [expediteurId], references: [id], onDelete: Cascade)
  expediteurId   Int
  destinataire   Utilisateur   @relation("MessagesRecus", fields: [destinataireId], references: [id], onDelete: Cascade)
  destinataireId Int
  evenement      Evenement?    @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  evenementId    Int?
  piecesJointes  PieceJointe[]
}

model PieceJointe {
  id        Int             @id @default(autoincrement())
  type      TypePieceJointe
  url       String          @db.VarChar(255)
  message   Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId Int
}

enum TypeMessage {
  TEXTE
  EMOJI
  GIF
  EVENEMENT
}

enum TypePieceJointe {
  IMAGE
  GIF
  FICHIER
}
